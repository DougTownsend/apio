// Project-local board override defining the "pico" board.
// See docs/custom-boards.md.
{
  "pico": {
    "description": "Raspberry Pi Pico — RP2040-based board running apio's software Verilog interpreter",
    "fpga-id": "rp2040",
    "programmer": {
      "id": "pico"
    }
    // -- Deliberately no "usb" section. A Pico has two USB identities:
    // -- 2E8A:000A while running the apio firmware (a CDC serial device),
    // -- and 2E8A:0003 while sitting in the BOOTSEL mass-storage
    // -- bootloader. apio's board-level "usb" check (_check_device_presence
    // -- in apio/managers/programmers.py) is a single filter, so it can't
    // -- express "either of these", and even matching both wouldn't say
    // -- which mode the board is in -- which is the thing the uploader
    // -- actually needs to know. Omitting the section makes that check a
    // -- no-op (it returns early when there's no "usb" section) and leaves
    // -- device detection entirely to apio/pico/upload.py, which scans for
    // -- both identities and reports a clear error when neither is found.
  }
}
