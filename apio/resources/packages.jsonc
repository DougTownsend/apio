// Definition of apio software packages. These are packages with various
// data and utilities that are installed by apio.
//
// Additional packages information is fetched dynamically from the remote
// config and is saved in .apio/profile.json.
//
{
  // "definitions" package
  "definitions": {
    "description": "Apio definitions",
    "env": {}
  },
  // "examples" package
  "examples": {
    "description": "Apio project examples",
    "restricted-to-platforms": [],
    "env": {}
  },
  // "oss-cad-suite" package
  "oss-cad-suite": {
    "description": "Yosys HQ oss-cad-suite",
    "env": {
      "unset-vars": [
        // Delete this var, if exists, o isolate the oss-cad-suite
        // embedded python from the local python.
        "PYTHONPATH"
      ],
      "path": [
        "%p/bin",
        "%p/lib"
      ],
      "set-vars": {
        "VERILATOR_ROOT": "%p/share/verilator",
        "ICEBOX": "%p/share/icebox",
        "TRELLIS": "%p/share/trellis",
        "YOSYS_LIB": "%p/share/yosys",
        // For 'apio build -g' on windows.
        "QT_PLUGIN_PATH": "%p/lib/qt5/plugins"
      }
    }
  },

  // "openxc7" package
  "openxc7": {
    "description": "Openxc7 toolchain (Xilinx FPGAs)",
    "env": {
      "path": [
        "%p/bin",
        "%p/lib"
      ],
      "set-vars": {
        "PRJXRAY_DB_DIR": "%p/share/nextpnr/external/prjxray-db",
        "CHIPDB_DIR": "%p/chipdb",

        //-- Default value. It is overriden before calling scons
        "ENV_BUILD_PATH": "_build/default"
      }
    }
  },

  // "graphviz" package
  "graphviz": {
    "restricted-to-platforms": [
      "windows-amd64"
    ],
    "description": "Graphviz tool for Windows",
    "env": {
      "path": [
        "%p/bin"
      ]
    }
  },
  // "verible" package
  "verible": {
    "description": "Chips Aliance Verible toolset",
    "env": {
      "path": [
        "%p/bin"
      ]
    }
  },
  // "drivers" package
  "drivers": {
    "restricted-to-platforms": [
      "windows-amd64"
    ],
    "description": "Drivers tools for Windows",
    "env": {
      "path": [
        "%p/bin"
      ]
    }
  },

  // -- Pico target toolchain packages, below. Unlike the packages above,
  // -- these reference upstream projects' own official release binaries
  // -- directly (see remote-config/apio-1.5.x.jsonc) rather than an
  // -- fpgawars-hosted mirror -- so each needs one entry per platform,
  // -- since none of those upstream release filenames happen to match
  // -- apio's ${PLATFORM} substitution token, and the "path" below must
  // -- match each release archive's own (versioned) top-level folder
  // -- name. Bumping a tool's version means updating both the filename
  // -- in remote-config and the folder name in "path" here together.

  // "picotool" package (flashes .uf2 firmware to a Pico over USB).
  // Official Raspberry Pi prebuilt binaries.
  "picotool-linux-x86-64": {
    "restricted-to-platforms": [
      "linux-x86-64"
    ],
    "description": "Picotool (Raspberry Pi Pico flashing tool)",
    "env": {
      "path": [
        "%p/picotool"
      ]
    }
  },
  "picotool-darwin-arm64": {
    "restricted-to-platforms": [
      "darwin-arm64"
    ],
    "description": "Picotool (Raspberry Pi Pico flashing tool)",
    "env": {
      "path": [
        "%p/picotool"
      ]
    }
  },
  "picotool-windows-amd64": {
    "restricted-to-platforms": [
      "windows-amd64"
    ],
    "description": "Picotool (Raspberry Pi Pico flashing tool)",
    "env": {
      "path": [
        "%p/picotool"
      ]
    }
  },

  // "cmake" package (builds the pico-target C firmware). Official
  // Kitware prebuilt binaries.
  "cmake-linux-x86-64": {
    "restricted-to-platforms": [
      "linux-x86-64"
    ],
    "description": "CMake (Kitware)",
    "env": {
      "path": [
        "%p/cmake-4.4.2-linux-x86_64/bin"
      ]
    }
  },
  "cmake-darwin-arm64": {
    "restricted-to-platforms": [
      "darwin-arm64"
    ],
    "description": "CMake (Kitware)",
    "env": {
      "path": [
        "%p/cmake-4.4.2-macos-universal/CMake.app/Contents/bin"
      ]
    }
  },
  "cmake-windows-amd64": {
    "restricted-to-platforms": [
      "windows-amd64"
    ],
    "description": "CMake (Kitware)",
    "env": {
      "path": [
        "%p/cmake-4.4.2-windows-x86_64/bin"
      ]
    }
  },

  // "arm-none-eabi-gcc" package (RP2040 cross-compiler). xPack's
  // repackaging of the official Arm GNU Toolchain releases.
  "arm-none-eabi-gcc-linux-x86-64": {
    "restricted-to-platforms": [
      "linux-x86-64"
    ],
    "description": "Arm GNU Toolchain (xPack)",
    "env": {
      "path": [
        "%p/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin"
      ]
    }
  },
  "arm-none-eabi-gcc-darwin-arm64": {
    "restricted-to-platforms": [
      "darwin-arm64"
    ],
    "description": "Arm GNU Toolchain (xPack)",
    "env": {
      "path": [
        "%p/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin"
      ]
    }
  },
  "arm-none-eabi-gcc-windows-amd64": {
    "restricted-to-platforms": [
      "windows-amd64"
    ],
    "description": "Arm GNU Toolchain (xPack)",
    "env": {
      "path": [
        "%p/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin"
      ]
    }
  },

  // "pico-sdk" package (Raspberry Pi Pico SDK). Official source from
  // raspberrypi/pico-sdk Github repository. Version-agnostic: the pico runtime
  // auto-detects the installed version by looking for pico-sdk-* directories.
  "pico-sdk-linux-x86-64": {
    "restricted-to-platforms": [
      "linux-x86-64"
    ],
    "description": "Raspberry Pi Pico SDK",
    "env": {}
  },
  "pico-sdk-darwin-arm64": {
    "restricted-to-platforms": [
      "darwin-arm64"
    ],
    "description": "Raspberry Pi Pico SDK",
    "env": {}
  },
  "pico-sdk-windows-amd64": {
    "restricted-to-platforms": [
      "windows-amd64"
    ],
    "description": "Raspberry Pi Pico SDK",
    "env": {}
  },

  // "tinyusb" package. Supplies the USB device stack that the pico-sdk
  // release tarball omits (it ships no git submodules) -- without it the
  // generated firmware builds but has no USB at all. apio/pico/runtime.py
  // points the SDK at this via PICO_TINYUSB_PATH.
  "tinyusb-linux-x86-64": {
    "restricted-to-platforms": [
      "linux-x86-64"
    ],
    "description": "TinyUSB (USB stack for the pico target)",
    "env": {}
  },
  "tinyusb-darwin-arm64": {
    "restricted-to-platforms": [
      "darwin-arm64"
    ],
    "description": "TinyUSB (USB stack for the pico target)",
    "env": {}
  },
  "tinyusb-windows-amd64": {
    "restricted-to-platforms": [
      "windows-amd64"
    ],
    "description": "TinyUSB (USB stack for the pico target)",
    "env": {}
  },

  // "ninja" package. The build generator for the pico firmware. Without it
  // cmake picks a generator from whatever happens to be installed on the
  // host -- 'NMake Makefiles' on Windows, which needs Visual Studio, and
  // 'Unix Makefiles' elsewhere, which needs make. Shipping ninja makes the
  // build self-contained and identical on all three platforms. The binary
  // sits at the root of the release zip, hence "%p" rather than "%p/bin".
  "ninja-linux-x86-64": {
    "restricted-to-platforms": [
      "linux-x86-64"
    ],
    "description": "Ninja build system",
    "env": {
      "path": [
        "%p"
      ]
    }
  },
  "ninja-darwin-arm64": {
    "restricted-to-platforms": [
      "darwin-arm64"
    ],
    "description": "Ninja build system",
    "env": {
      "path": [
        "%p"
      ]
    }
  },
  "ninja-windows-amd64": {
    "restricted-to-platforms": [
      "windows-amd64"
    ],
    "description": "Ninja build system",
    "env": {
      "path": [
        "%p"
      ]
    }
  }
}
